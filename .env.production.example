# Copy to .env on the server; never commit the real file. scripts/deploy.sh generates it automatically.

# Postgres (use URL-safe values; password goes into DATABASE_URL). Generate: openssl rand -hex 24
POSTGRES_USER=ajaia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ajaia_docs

# Cookie signing secret. Generate: openssl rand -hex 32
SESSION_SECRET=change-me

# Served over HTTPS via Caddy, so cookies are Secure-only. Use false only for plain-HTTP local runs.
COOKIE_SECURE=true
# Proxies in front of the API: Caddy + Next.js rewrite. Keeps rate limiting per real client IP.
TRUST_PROXY_HOPS=2

# Web port (bound to 127.0.0.1 by docker-compose.edge.yml) and the browser origin(s) the API accepts.
WEB_PORT=8081
ALLOWED_ORIGINS=https://docs.51-170-90-86.sslip.io

# Run the idempotent demo seed on every API start.
SEED_ON_START=true

# Image tag for ajaia-docs-api / ajaia-docs-web.
IMAGE_TAG=latest
