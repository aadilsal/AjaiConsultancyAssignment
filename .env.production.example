# Copy to .env on the server; never commit the real file. scripts/deploy.sh generates it automatically.

# Postgres (use URL-safe values; password goes into DATABASE_URL). Generate: openssl rand -hex 24
POSTGRES_USER=ajaia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ajaia_docs

# Cookie signing secret. Generate: openssl rand -hex 32
SESSION_SECRET=change-me

# false only because the demo is served over plain HTTP on a raw IP; set true once behind HTTPS.
COOKIE_SECURE=false

# Public host port for the web app, and the browser origin(s) the API accepts (comma-separated).
WEB_PORT=8081
ALLOWED_ORIGINS=http://51.170.90.86:8081

# Run the idempotent demo seed on every API start.
SEED_ON_START=true

# Image tag for ajaia-docs-api / ajaia-docs-web.
IMAGE_TAG=latest
