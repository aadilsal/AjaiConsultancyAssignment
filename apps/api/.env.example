# Postgres connection string
DATABASE_URL=postgresql://ajaia:ajaia@localhost:5434/ajaia?schema=public
# JWT signing secret, at least 32 chars
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# "true" behind HTTPS; defaults to true when NODE_ENV=production
COOKIE_SECURE=false
# Comma-separated origins allowed for state-changing requests
ALLOWED_ORIGINS=http://localhost:3000
# Reverse proxies in front of the API (Caddy + Next.js = 2) so req.ip is the client IP
TRUST_PROXY_HOPS=1
# Global requests/min per IP
THROTTLE_LIMIT=120
PORT=4000
NODE_ENV=development
